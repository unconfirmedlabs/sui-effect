{
  "name": "@your-org/example-extension",
  "version": "0.0.0",
  "description": "A copyable sui-effect extension package: one service, three layers, a derived Promise face.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:package": "bun scripts/check-package.ts",
    "check": "tsc --noEmit && bun test && bun scripts/check-package.ts"
  },
  "peerDependencies": {
    "@mysten/bcs": "^2.1.3",
    "@mysten/sui": "^2.28",
    "effect": ">=4.1.1 <4.2",
    "@unconfirmed/sui-effect": ">=0.6.0 <0.7.0"
  },
  "peerDependenciesMeta": {
    "@unconfirmed/sui-effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@mysten/bcs": "2.1.3",
    "@mysten/sui": "2.38.0",
    "@types/bun": "1.4.2",
    "effect": "4.1.1",
    "typescript": "5.9.3"
  }
}
