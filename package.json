{
  "name": "@unconfirmed/sui-effect",
  "version": "0.6.0",
  "description": "A light Effect v4 wrapper around @mysten/sui: typed errors, cancellation and spans on every call, and a crash-safe transaction lifecycle.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tx": {
      "types": "./dist/tx.d.ts",
      "import": "./dist/tx.js"
    },
    "./journal": {
      "types": "./dist/journal.d.ts",
      "import": "./dist/journal.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LLMS.md",
    "AGENTS.md",
    "DESIGN.md"
  ],
  "scripts": {
    "prepare": "effect-language-service patch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "llms": "bun scripts/llms.ts",
    "check": "tsc --noEmit && bun run build && bun test test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unconfirmedlabs/sui-effect.git"
  },
  "keywords": [
    "sui",
    "effect",
    "typescript",
    "blockchain",
    "move"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@scure/bip39": "^2.3.0"
  },
  "peerDependencies": {
    "@mysten/bcs": "^2.1.3",
    "@mysten/sui": "^2.28",
    "effect": ">=4.1.1 <4.2"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/platform-bun": "4.1.1",
    "@mysten/bcs": "2.1.3",
    "@mysten/sui": "2.38.0",
    "@types/bun": "1.4.2",
    "effect": "4.1.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
