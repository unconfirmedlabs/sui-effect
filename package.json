{
  "name": "@unconfirmed/sui-effect",
  "version": "0.1.2",
  "description": "An opinionated Effect v4 layer over @mysten/sui: two client tiers, closed error unions, and a typed transaction lifecycle.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tx": {
      "types": "./dist/tx.d.ts",
      "import": "./dist/tx.js"
    },
    "./journal": {
      "types": "./dist/journal.d.ts",
      "import": "./dist/journal.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "import": "./dist/script.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LLMS.md",
    "AGENTS.md",
    "docs/extensions.md",
    "examples/extension-template",
    "!examples/extension-template/dist"
  ],
  "scripts": {
    "prepare": "effect-language-service patch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "test:template": "cd examples/extension-template && bun test",
    "check:template": "cd examples/extension-template && tsc --noEmit && bun test && bun scripts/check-package.ts",
    "llms": "bun scripts/llms.ts",
    "docs:extensions": "bun scripts/extensions.ts",
    "check": "tsc --noEmit && bun run build && bun test test/ && bun run check:template"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unconfirmedlabs/sui-effect.git"
  },
  "keywords": [
    "sui",
    "effect",
    "typescript",
    "blockchain",
    "move"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "peerDependencies": {
    "@mysten/bcs": "^2.1.1",
    "@mysten/sui": "^2.28",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@mysten/bcs": "2.1.1",
    "@mysten/sui": "2.30.0",
    "@types/bun": "1.4.2",
    "effect": "4.0.0-rc.112",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
